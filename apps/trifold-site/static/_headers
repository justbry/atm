# Cloudflare Pages headers. Prerendered pages also carry a <meta> CSP from SvelteKit that allows only the hashed inline
# scripts (its bootstrap and the theme script); this header's 'unsafe-inline' for scripts is narrowed by that meta CSP,
# since a browser enforces both. Inline styles are allowed (component style attributes). No third-party origins.
# connect-src/form-action allow https: so the early-access form can post to PUBLIC_FORM_ENDPOINT; narrow them to that
# origin once it is chosen.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https:; form-action 'self' https: mailto:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

# Agent files (scripts/agent-files.ts). llms.txt stays indexable; llms-full.txt and the .md mirrors repeat the pages,
# so they're noindex. Each mirror's block is appended to build/_headers by that script, since the mirrors follow the
# pages and competitors.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex
