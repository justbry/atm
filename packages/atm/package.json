{
	"name": "atm",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Autumn's balance engine as a local CLI: run engine commands against a subject, and (next) build, check and replay a school's ledger.",
	"bin": {
		"atm": "./src/bin.ts"
	},
	"scripts": {
		"atm": "bun ./src/bin.ts",
		"build": "bun build ./src/bin.ts --target=bun --outfile=dist/atm.js",
		"test": "bun test tests",
		"ts": "tsc --noEmit"
	},
	"dependencies": {
		"@autumn/balance-engine": "workspace:*",
		"commander": "14.0.3"
	},
	"devDependencies": {
		"@types/bun": "1.4.2",
		"typescript": "~5.8.3"
	}
}
