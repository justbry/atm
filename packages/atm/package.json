{
	"name": "atm",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Autumn's balance engine as a local CLI and a TypeScript library: run engine commands against a subject; next, build, check and replay a school's ledger.",
	"bin": {
		"atm": "./src/bin.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"bun": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"atm": "bun ./src/bin.ts",
		"build": "bun ./build.ts",
		"test": "bun test tests",
		"ts": "tsc --noEmit",
		"fixtures": "bun ./fixtures/generate.ts",
		"schema": "bun ./schema/build.ts"
	},
	"dependencies": {
		"@autumn/balance-engine": "workspace:*",
		"commander": "14.0.3",
		"ajv": "8.20.0"
	},
	"devDependencies": {
		"@types/bun": "1.4.2",
		"typescript": "~5.8.3"
	}
}
