{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://b4uni.com/_schema/payload/plan.attached.v1.json",
	"title": "plan.attached payload v1",
	"description": "The applyBillingPlan command and the mutation the engine decided. No postings: balances a plan moves are credit.* events with cause.",
	"type": "object",
	"required": ["command", "mutation"],
	"properties": {
		"command": {
			"type": "object",
			"required": ["type", "commandId", "occurredAt"],
			"properties": {
				"type": {
					"type": "string",
					"minLength": 1
				},
				"commandId": {
					"type": "string",
					"minLength": 1
				},
				"occurredAt": {
					"type": "integer"
				}
			}
		},
		"mutation": {
			"type": "object",
			"required": ["id", "revision", "changes", "result"],
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"revision": {
					"type": "object",
					"required": ["before", "after"]
				},
				"changes": {
					"type": "array"
				},
				"result": {
					"type": "object"
				}
			}
		}
	}
}
