{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://b4uni.com/_schema/payload/payment.refunded.v1.json",
	"title": "payment.refunded payload v1",
	"description": "A Stripe refund. Amounts in cents.",
	"type": "object",
	"required": ["id", "amount", "currency"],
	"properties": {
		"id": {
			"type": "string",
			"minLength": 1
		},
		"amount": {
			"type": "integer",
			"minimum": 1
		},
		"currency": {
			"type": "string",
			"minLength": 1
		},
		"billing_email": {
			"x-personal": true,
			"type": "string"
		}
	}
}
