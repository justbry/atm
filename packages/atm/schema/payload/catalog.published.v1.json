{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://b4uni.com/_schema/payload/catalog.published.v1.json",
	"title": "catalog.published payload v1",
	"description": "Plan versions published, with the full menu they came from and its version. No postings. The grant rules read the menu.",
	"type": "object",
	"required": ["plans"],
	"properties": {
		"plans": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"version": {
			"type": ["integer", "string"]
		},
		"menu": {
			"type": "object"
		}
	}
}
