{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://b4uni.com/_schema/payload/share.charged.v1.json",
	"title": "share.charged payload v1",
	"description": "The school's part of its organization's monthly share.",
	"type": "object",
	"required": ["organization", "month"],
	"properties": {
		"organization": {
			"type": "string",
			"minLength": 1
		},
		"month": {
			"type": "string",
			"pattern": "^\\d{4}-\\d{2}$"
		},
		"amount": {
			"type": "integer"
		}
	}
}
