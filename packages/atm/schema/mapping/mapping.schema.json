{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://b4uni.com/_schema/mapping/mapping.schema.json",
	"title": "Stripe webhook mapping v1",
	"description": "Declarative map from one raw Stripe event type (pinned to one API version) to a normalized billing fact. A Stripe API change means a new mapping file with a new stripeApiVersion, not new code.",
	"type": "object",
	"required": [
		"v",
		"source",
		"event",
		"target",
		"stripeApiVersion",
		"fields",
		"personal"
	],
	"additionalProperties": false,
	"properties": {
		"v": { "type": "integer", "minimum": 1 },
		"source": { "const": "stripe" },
		"event": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)+$" },
		"target": {
			"enum": [
				"BillingInvoice",
				"BillingRefund",
				"BillingDispute",
				"SubscriptionFact",
				"InvoicePaymentFact",
				"StripePayout"
			]
		},
		"stripeApiVersion": {
			"type": "string",
			"pattern": "^\\d{4}-\\d{2}-\\d{2}\\.[a-z]+$"
		},
		"fields": {
			"type": "object",
			"additionalProperties": { "$ref": "#/$defs/field" }
		},
		"lines": {
			"type": "object",
			"required": ["path", "fields"],
			"additionalProperties": false,
			"properties": {
				"path": { "$ref": "#/$defs/path" },
				"fields": {
					"type": "object",
					"additionalProperties": { "$ref": "#/$defs/field" }
				}
			}
		},
		"personal": { "type": "array", "items": { "$ref": "#/$defs/path" } }
	},
	"$defs": {
		"path": {
			"type": "string",
			"pattern": "^\\$((\\.[A-Za-z0-9_]+)|(\\[\\d+\\]))*$"
		},
		"field": {
			"type": "object",
			"required": ["path", "type"],
			"additionalProperties": false,
			"properties": {
				"path": { "$ref": "#/$defs/path" },
				"type": { "enum": ["string", "int", "seconds", "bool", "map", "sum"] },
				"optional": { "type": "boolean" },
				"default": {},
				"values": {
					"type": "object",
					"additionalProperties": { "type": ["string", "null"] }
				},
				"fallback": { "type": ["string", "null"] },
				"equalsPath": { "$ref": "#/$defs/path" },
				"each": { "$ref": "#/$defs/path" },
				"min": { "type": "integer" },
				"max": { "type": "integer" }
			}
		}
	}
}
