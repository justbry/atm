{
	"v": 1,
	"source": "stripe",
	"event": "invoice.paid",
	"target": "BillingInvoice",
	"stripeApiVersion": "2025-10-29.clover",
	"fields": {
		"id": {
			"path": "$.data.object.id",
			"type": "string"
		},
		"customerId": {
			"path": "$.data.object.customer",
			"type": "string"
		},
		"subscriptionId": {
			"path": "$.data.object.parent.subscription_details.subscription",
			"type": "string",
			"optional": true,
			"default": null
		},
		"reason": {
			"path": "$.data.object.billing_reason",
			"type": "string",
			"values": {
				"subscription_create": "subscription_create",
				"subscription_cycle": "subscription_cycle",
				"subscription_update": "subscription_update",
				"manual": "manual"
			},
			"fallback": "other"
		},
		"currency": {
			"path": "$.data.object.currency",
			"type": "string"
		},
		"amountPaid": {
			"path": "$.data.object.amount_paid",
			"type": "int"
		},
		"discount": {
			"path": "$.data.object.total_discount_amounts",
			"type": "sum",
			"each": "$.amount",
			"optional": true
		},
		"paidAt": {
			"path": "$.data.object.status_transitions.paid_at",
			"type": "seconds"
		},
		"periodStart": {
			"path": "$.data.object.period_start",
			"type": "seconds"
		},
		"periodEnd": {
			"path": "$.data.object.period_end",
			"type": "seconds"
		},
		"number": {
			"path": "$.data.object.number",
			"type": "string",
			"optional": true,
			"default": null
		},
		"hostedInvoiceUrl": {
			"path": "$.data.object.hosted_invoice_url",
			"type": "string",
			"optional": true,
			"default": null
		},
		"invoicePdf": {
			"path": "$.data.object.invoice_pdf",
			"type": "string",
			"optional": true,
			"default": null
		},
		"metadata": {
			"path": "$.data.object.metadata",
			"type": "map"
		},
		"subscriptionMetadata": {
			"path": "$.data.object.parent.subscription_details.metadata",
			"type": "map",
			"optional": true,
			"default": {}
		}
	},
	"lines": {
		"path": "$.data.object.lines.data",
		"fields": {
			"priceId": {
				"path": "$.pricing.price_details.price",
				"type": "string",
				"optional": true,
				"default": null
			},
			"quantity": {
				"path": "$.quantity",
				"type": "int",
				"optional": true,
				"default": 1,
				"min": 0,
				"max": 99999999
			},
			"proration": {
				"path": "$.parent.subscription_item_details.proration",
				"type": "bool",
				"optional": true,
				"default": false
			},
			"amount": {
				"path": "$.amount",
				"type": "int"
			},
			"discount": {
				"path": "$.discount_amounts",
				"type": "sum",
				"each": "$.amount",
				"optional": true
			},
			"periodStart": {
				"path": "$.period.start",
				"type": "seconds",
				"optional": true
			},
			"periodEnd": {
				"path": "$.period.end",
				"type": "seconds",
				"optional": true
			}
		}
	},
	"personal": [
		"$.data.object.customer_email",
		"$.data.object.customer_name",
		"$.data.object.customer_address",
		"$.data.object.customer_phone",
		"$.data.object.customer_shipping",
		"$.data.object.customer_tax_ids",
		"$.data.object.customer.email",
		"$.data.object.customer.name",
		"$.data.object.customer.address",
		"$.data.object.customer.phone"
	]
}
