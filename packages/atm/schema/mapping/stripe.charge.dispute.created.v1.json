{
	"v": 1,
	"source": "stripe",
	"event": "charge.dispute.created",
	"target": "BillingDispute",
	"stripeApiVersion": "2025-10-29.clover",
	"fields": {
		"id": { "path": "$.data.object.id", "type": "string" },
		"invoiceId": {
			"path": "$.data.object.invoice",
			"type": "string",
			"optional": true,
			"default": null
		},
		"chargeId": { "path": "$.data.object.charge", "type": "string" },
		"status": {
			"path": "$.data.object.status",
			"type": "string",
			"values": { "won": "won", "lost": "lost" },
			"fallback": "open"
		},
		"at": { "path": "$.created", "type": "seconds" }
	},
	"personal": ["$.data.object.evidence", "$.data.object.payment_method_details"]
}
