{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://b4uni.com/_schema/catalog/menu.v1.json",
	"title": "School billing menu v1",
	"description": "A school's menu: features (credits), tiers (memberships) and add-ons. Amounts are cents of `currency`. Limits match the family service's MenuSchema. Text fields are trimmed before they are checked (validateMenu does that); the rules a schema cannot say (unique ids, grants name a feature, one price per interval, a gift is a one-time add-on, a real time zone) are in validateMenu.",
	"type": "object",
	"additionalProperties": false,
	"required": ["currency", "timeZone", "features", "tiers", "addons"],
	"properties": {
		"currency": { "type": "string", "pattern": "^[a-z]{3}$" },
		"timeZone": { "type": "string", "minLength": 1, "maxLength": 64 },
		"features": {
			"type": "array",
			"maxItems": 12,
			"items": { "$ref": "#/$defs/feature" }
		},
		"tiers": {
			"type": "array",
			"maxItems": 4,
			"items": { "$ref": "#/$defs/tier" }
		},
		"addons": {
			"type": "array",
			"maxItems": 6,
			"items": { "$ref": "#/$defs/addon" }
		}
	},
	"$defs": {
		"id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$" },
		"amount": { "type": "integer", "minimum": 50, "maximum": 10000000 },
		"interval": { "enum": ["month", "year"] },
		"feature": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "unit"],
			"properties": {
				"id": { "$ref": "#/$defs/id" },
				"name": { "type": "string", "minLength": 1, "maxLength": 60 },
				"unit": {
					"type": "object",
					"additionalProperties": false,
					"required": ["one", "other"],
					"properties": {
						"one": { "type": "string", "minLength": 1, "maxLength": 30 },
						"other": { "type": "string", "minLength": 1, "maxLength": 30 }
					}
				}
			}
		},
		"rollover": {
			"type": "object",
			"additionalProperties": false,
			"required": ["months"],
			"properties": {
				"max": { "type": "integer", "minimum": 1, "maximum": 1000000 },
				"months": { "type": "integer", "minimum": 1, "maximum": 24 }
			}
		},
		"grant": {
			"type": "object",
			"additionalProperties": false,
			"required": ["featureId", "amount", "every"],
			"properties": {
				"featureId": { "$ref": "#/$defs/id" },
				"amount": { "type": "integer", "minimum": 1, "maximum": 100000 },
				"every": { "$ref": "#/$defs/interval" },
				"rollover": { "$ref": "#/$defs/rollover" }
			}
		},
		"tier": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "blurb", "public", "prices", "grants"],
			"properties": {
				"id": { "$ref": "#/$defs/id" },
				"name": { "type": "string", "minLength": 1, "maxLength": 60 },
				"blurb": { "type": "string", "maxLength": 300 },
				"public": { "type": "boolean" },
				"prices": {
					"type": "array",
					"minItems": 1,
					"maxItems": 2,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["interval", "amount"],
						"properties": {
							"interval": { "$ref": "#/$defs/interval" },
							"amount": { "$ref": "#/$defs/amount" }
						}
					}
				},
				"grants": {
					"type": "array",
					"maxItems": 12,
					"items": { "$ref": "#/$defs/grant" }
				}
			}
		},
		"addon": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "price", "grants"],
			"properties": {
				"id": { "$ref": "#/$defs/id" },
				"name": { "type": "string", "minLength": 1, "maxLength": 60 },
				"price": {
					"type": "object",
					"additionalProperties": false,
					"required": ["amount", "every"],
					"properties": {
						"amount": { "$ref": "#/$defs/amount" },
						"every": { "enum": ["once", "month", "year"] }
					}
				},
				"grants": {
					"type": "array",
					"maxItems": 12,
					"items": { "$ref": "#/$defs/grant" }
				},
				"gift": { "enum": ["sessions", "dollars"] }
			}
		}
	}
}
