{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://b4uni.com/_schema/note-event.v1.json",
	"title": "Promissory note event v1",
	"description": "One event in a note's append-only stream (docs/specs/promissory-notes.md). Money is an integer count of minor units as a digit string, rates are decimal strings, dates are civil YYYY-MM-DD. This schema checks the shape of one event only. These are checked in code (src/events.ts, parseNoteEvent and validateStream), not by this schema: calendar validity of every date (a real day of a real month, leap years included), strictly increasing custom installment dates after issue_date, first_due after issue_date, an amortized count of at most 5200 whose last due date stays within year 9999, and every stream rule (seq with no gap or repeat, unique ids, targets that exist earlier, who may confirm or dispute, a reversal that equals its payment, is dated on or after it and is the only reversal of it).",
	"oneOf": [
		{
			"title": "note.created",
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schema",
				"id",
				"note_id",
				"seq",
				"entered_at",
				"entered_by",
				"type",
				"terms"
			],
			"properties": {
				"schema": { "$ref": "#/$defs/schema" },
				"id": { "$ref": "#/$defs/text" },
				"note_id": { "$ref": "#/$defs/text" },
				"seq": { "$ref": "#/$defs/seq" },
				"entered_at": { "$ref": "#/$defs/instant" },
				"entered_by": { "$ref": "#/$defs/role" },
				"type": { "const": "note.created" },
				"terms": { "$ref": "#/$defs/terms" }
			}
		},
		{
			"title": "payment.recorded",
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schema",
				"id",
				"note_id",
				"seq",
				"entered_at",
				"entered_by",
				"type",
				"kind",
				"amount_minor",
				"value_date"
			],
			"properties": {
				"schema": { "$ref": "#/$defs/schema" },
				"id": { "$ref": "#/$defs/text" },
				"note_id": { "$ref": "#/$defs/text" },
				"seq": { "$ref": "#/$defs/seq" },
				"entered_at": { "$ref": "#/$defs/instant" },
				"entered_by": { "$ref": "#/$defs/role" },
				"type": { "const": "payment.recorded" },
				"kind": { "enum": ["payment", "reversal"] },
				"amount_minor": { "$ref": "#/$defs/minor_unsigned" },
				"value_date": { "$ref": "#/$defs/civil_date" },
				"method": { "type": "string" },
				"reference": { "type": "string" },
				"reverses": { "$ref": "#/$defs/text" },
				"source": {
					"description": "A backfilled past payment's label. both-agree is derived from a confirmation and is never recorded.",
					"enum": ["lender-states", "borrower-states"]
				}
			},
			"if": {
				"properties": { "kind": { "const": "reversal" } },
				"required": ["kind"]
			},
			"then": { "required": ["reverses"] },
			"else": { "not": { "required": ["reverses"] } }
		},
		{
			"title": "payment.confirmed",
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schema",
				"id",
				"note_id",
				"seq",
				"entered_at",
				"entered_by",
				"type",
				"target"
			],
			"properties": {
				"schema": { "$ref": "#/$defs/schema" },
				"id": { "$ref": "#/$defs/text" },
				"note_id": { "$ref": "#/$defs/text" },
				"seq": { "$ref": "#/$defs/seq" },
				"entered_at": { "$ref": "#/$defs/instant" },
				"entered_by": { "$ref": "#/$defs/role" },
				"type": { "const": "payment.confirmed" },
				"target": { "$ref": "#/$defs/text" }
			}
		},
		{
			"title": "payment.disputed",
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schema",
				"id",
				"note_id",
				"seq",
				"entered_at",
				"entered_by",
				"type",
				"target",
				"counter_amount_minor",
				"reason"
			],
			"properties": {
				"schema": { "$ref": "#/$defs/schema" },
				"id": { "$ref": "#/$defs/text" },
				"note_id": { "$ref": "#/$defs/text" },
				"seq": { "$ref": "#/$defs/seq" },
				"entered_at": { "$ref": "#/$defs/instant" },
				"entered_by": { "$ref": "#/$defs/role" },
				"type": { "const": "payment.disputed" },
				"target": { "$ref": "#/$defs/text" },
				"counter_amount_minor": { "$ref": "#/$defs/minor_unsigned" },
				"reason": { "$ref": "#/$defs/text" }
			}
		},
		{
			"title": "payment.resolved",
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schema",
				"id",
				"note_id",
				"seq",
				"entered_at",
				"entered_by",
				"type",
				"target",
				"agreed_amount_minor"
			],
			"properties": {
				"schema": { "$ref": "#/$defs/schema" },
				"id": { "$ref": "#/$defs/text" },
				"note_id": { "$ref": "#/$defs/text" },
				"seq": { "$ref": "#/$defs/seq" },
				"entered_at": { "$ref": "#/$defs/instant" },
				"entered_by": { "$ref": "#/$defs/role" },
				"type": { "const": "payment.resolved" },
				"target": { "$ref": "#/$defs/text" },
				"agreed_amount_minor": { "$ref": "#/$defs/minor_unsigned" }
			}
		},
		{
			"title": "annotation.added",
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schema",
				"id",
				"note_id",
				"seq",
				"entered_at",
				"entered_by",
				"type",
				"text"
			],
			"properties": {
				"schema": { "$ref": "#/$defs/schema" },
				"id": { "$ref": "#/$defs/text" },
				"note_id": { "$ref": "#/$defs/text" },
				"seq": { "$ref": "#/$defs/seq" },
				"entered_at": { "$ref": "#/$defs/instant" },
				"entered_by": { "$ref": "#/$defs/role" },
				"type": { "const": "annotation.added" },
				"text": { "$ref": "#/$defs/text" },
				"attachment_sha256": { "$ref": "#/$defs/sha256" },
				"target": { "$ref": "#/$defs/text" }
			}
		}
	],
	"$defs": {
		"schema": { "const": "tfd.note-event.v1" },
		"text": { "type": "string", "minLength": 1 },
		"seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
		"role": { "enum": ["lender", "borrower"] },
		"minor_unsigned": {
			"description": "A non-negative integer count of minor units as digits, no leading zero. No event field carries a negative amount; a signed form would be ^(0|-?[1-9][0-9]*)$.",
			"type": "string",
			"pattern": "^(0|[1-9][0-9]*)$"
		},
		"minor_positive": {
			"description": "A positive integer count of minor units as digits, no leading zero: at least 1.",
			"type": "string",
			"pattern": "^[1-9][0-9]*$"
		},
		"civil_date": {
			"description": "A civil date. The pattern fixes the shape; the validator also checks it is a real calendar date, leap years included.",
			"type": "string",
			"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
		},
		"instant": {
			"description": "An ISO 8601 UTC instant ending in Z.",
			"type": "string",
			"pattern": "^\\d{4}-\\d{2}-\\d{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
		},
		"sha256": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		},
		"annual_rate": {
			"description": "A decimal string below 1 with at most 6 places: \"0.0525\", \"0\".",
			"type": "string",
			"pattern": "^(0|0\\.[0-9]{1,6})$"
		},
		"terms": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"currency",
				"exponent",
				"principal_minor",
				"issue_date",
				"annual_rate",
				"day_count",
				"rounding",
				"timezone",
				"schedule"
			],
			"properties": {
				"currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
				"exponent": { "type": "integer", "minimum": 0, "maximum": 4 },
				"principal_minor": { "$ref": "#/$defs/minor_positive" },
				"issue_date": { "$ref": "#/$defs/civil_date" },
				"annual_rate": { "$ref": "#/$defs/annual_rate" },
				"day_count": { "const": "actual/365" },
				"rounding": { "const": "half-up" },
				"timezone": { "$ref": "#/$defs/text" },
				"schedule": { "$ref": "#/$defs/schedule" },
				"document_sha256": { "$ref": "#/$defs/sha256" }
			}
		},
		"schedule": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "frequency", "count", "first_due"],
					"properties": {
						"type": { "const": "amortized" },
						"frequency": { "enum": ["weekly", "biweekly", "monthly"] },
						"count": {
							"type": "integer",
							"minimum": 1,
							"maximum": 9007199254740991
						},
						"first_due": { "$ref": "#/$defs/civil_date" }
					}
				},
				{
					"description": "Due dates strictly increase and fall after issue_date; the validator checks the order, which a JSON Schema cannot.",
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "installments"],
					"properties": {
						"type": { "const": "custom" },
						"installments": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "object",
								"additionalProperties": false,
								"required": ["due", "amount_minor"],
								"properties": {
									"due": { "$ref": "#/$defs/civil_date" },
									"amount_minor": { "$ref": "#/$defs/minor_unsigned" }
								}
							}
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type"],
					"properties": {
						"type": { "const": "none" }
					}
				}
			]
		}
	}
}
